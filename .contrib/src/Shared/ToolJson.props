<Project>
  <PropertyGroup>
    <AttJsonBackend Condition="'$(AttJsonBackend)' == '' And $([MSBuild]::GetTargetFrameworkIdentifier('$(TargetFramework)')) == '.NETFramework'">MiniJson</AttJsonBackend>
    <AttJsonBackend Condition="'$(AttJsonBackend)' == ''">SystemTextJson</AttJsonBackend>
  </PropertyGroup>
  <Import Project="..\MiniJSON\MiniJSON.props" Condition="'$(AttJsonBackend)' == 'MiniJson'" />
  <ItemGroup Condition="'$(AttJsonLegacyApiOnly)' != 'true'">
    <Compile Include="$(MSBuildThisFileDirectory)..\Json\JsonData.cs" Link="Shared\JsonData.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)ToolJson.cs" Link="Shared\ToolJson.cs" />
  </ItemGroup>
  <PropertyGroup Condition="'$(AttJsonLegacyApiOnly)' != 'true' And '$(AttJsonBackend)' == 'MiniJson'">
    <DefineConstants>$(DefineConstants);ATT_USE_MINIJSON</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(AttJsonLegacyApiOnly)' != 'true' And '$(AttJsonBackend)' == 'MiniJson'">
    <Compile Include="$(MSBuildThisFileDirectory)..\MiniJSON\MiniJsonBackend.cs" Link="Shared\MiniJsonBackend.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(AttJsonLegacyApiOnly)' != 'true' And '$(AttJsonBackend)' == 'SystemTextJson'">
    <Compile Include="$(MSBuildThisFileDirectory)..\Json\SystemTextJsonBackend.cs" Link="Shared\SystemTextJsonBackend.cs" />
    <PackageReference Include="System.Text.Json" Version="[10.0.15]" Condition="$([MSBuild]::GetTargetFrameworkIdentifier('$(TargetFramework)')) == '.NETFramework'" />
  </ItemGroup>
  <PropertyGroup Condition="'$(AttJsonLegacyApiOnly)' != 'true' And '$(AttJsonBackend)' == 'NewtonsoftJson'">
    <DefineConstants>$(DefineConstants);ATT_USE_NEWTONSOFTJSON</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(AttJsonLegacyApiOnly)' != 'true' And '$(AttJsonBackend)' == 'NewtonsoftJson'">
    <Compile Include="$(MSBuildThisFileDirectory)..\Json\NewtonsoftJsonBackend.cs" Link="Shared\NewtonsoftJsonBackend.cs" />
    <!-- Parser and AssetDB Builder share .tools, so deploy the same assembly for both target frameworks. -->
    <PackageReference Include="Newtonsoft.Json" Version="[13.0.4]" ExcludeAssets="compile;runtime" GeneratePathProperty="true" />
    <Reference Include="Newtonsoft.Json" HintPath="$(PkgNewtonsoft_Json)/lib/netstandard2.0/Newtonsoft.Json.dll" Private="true" />
  </ItemGroup>
  <Target Name="ValidateAttJsonBackend" BeforeTargets="PrepareForBuild;CollectPackageReferences" Condition="'$(AttJsonBackend)' != 'SystemTextJson' And '$(AttJsonBackend)' != 'MiniJson' And '$(AttJsonBackend)' != 'NewtonsoftJson'">
    <Error Text="Unsupported AttJsonBackend '$(AttJsonBackend)'. Choose SystemTextJson, MiniJson, or NewtonsoftJson." />
  </Target>
</Project>
