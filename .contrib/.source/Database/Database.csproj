<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Platforms>x64;ARM64;AnyCPU</Platforms>
    <Platform>x64</Platform>
    <PlatformTarget>$(Platform)</PlatformTarget>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>ATT</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <OutputPath>bin\$(Platform)\$(Configuration)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Platform)' == 'AnyCPU'">
    <Prefer32Bit>false</Prefer32Bit>
    <DefineConstants>$(DefineConstants);ATT_ANYCPU</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <OutputPath>bin\$(Platform)\Retail\</OutputPath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Classic Era' Or '$(Configuration)' == 'Classic TBC' Or '$(Configuration)' == 'Classic Wrath'">
    <Optimize>true</Optimize>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release' Or '$(Configuration)' == 'Classic Era' Or '$(Configuration)' == 'Classic TBC' Or '$(Configuration)' == 'Classic Wrath'">
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup Condition="'$(Platform)' == 'AnyCPU'">
    <Compile Include="..\NativeLua.cs" Link="NativeLua.cs" />
    <Reference Include="System.Runtime.InteropServices.RuntimeInformation" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="KeraLua" Version="[1.4.11]" />
    <PackageReference Include="NLua" Version="[1.7.9]" />
  </ItemGroup>
  <Target Name="ValidateDatabasePlatform" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(Platform)' != 'x64' and '$(Platform)' != 'ARM64' and '$(Platform)' != 'AnyCPU'" Text="Database supports x64, ARM64, and AnyCPU platforms." />
  </Target>
  <Target Name="RemoveUnsupportedAnyCpuLua" AfterTargets="CopyFilesToOutputDirectory" Condition="'$(Platform)' == 'AnyCPU'">
    <Delete Files="$(TargetDir)lua54.dll;$(TargetDir)x86\lua54.dll" />
  </Target>
</Project>
