root = true

[*]
trim_trailing_whitespace = true
insert_final_newline = true
indent_style = space
indent_size = 4

[*.lua]
end_of_line = crlf
indent_style = tab

[.config/.exports/**]
trim_trailing_whitespace = false

[.contrib/Harvesters/**]
trim_trailing_whitespace = false

[.contrib/Debugging/**]
trim_trailing_whitespace = false
