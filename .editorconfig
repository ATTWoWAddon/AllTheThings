root = true

[*]
charset = utf-8
end_of_line = lf
trim_trailing_whitespace = true
insert_final_newline = true
indent_style = space
indent_size = 4

[*.lua]
indent_style = tab

[*.{yml,yaml}]
indent_style = space
indent_size = 2

# Visual Studio / MSBuild project files (legacy and SDK-style)
[*.{csproj,vbproj,fsproj,vcxproj,vcxproj.filters,proj,projitems,shproj,sqlproj,props,targets,slnx}]
indent_style = space
indent_size = 2

[*.{bat,cmd}]
end_of_line = crlf

# Raw Wago CSV fields include meaningful spaces in multiline localized text.
[.contrib/.db/standard/.config/.wago/**.csv]
trim_trailing_whitespace = false

[.config/.exports/**]
trim_trailing_whitespace = false

[.contrib/Harvesters/**]
trim_trailing_whitespace = false

[.contrib/Debugging/**]
trim_trailing_whitespace = false
[/{AllTheThings.lua,lib/**.lua,src/**.lua}]
charset = utf-8
end_of_line = lf
indent_style = tab
indent_size = 4
tab_width = 4
trim_trailing_whitespace = true
insert_final_newline = true

[/{tests,locales}/*.lua]
charset = utf-8
end_of_line = lf
indent_style = tab
indent_size = 4
tab_width = 4
trim_trailing_whitespace = true
insert_final_newline = true

# Binary assets (BLP, OGG, WAV)
[assets/**]
charset = unset
end_of_line = unset
indent_style = unset
indent_size = unset
tab_width = unset
trim_trailing_whitespace = unset
insert_final_newline = unset

# Binary asset extensions (BLP, OGG, WAV)
[**.{blp,ogg,wav}]
charset = unset
end_of_line = unset
indent_style = unset
indent_size = unset
tab_width = unset
trim_trailing_whitespace = unset
insert_final_newline = unset

[/{Bindings.xml,src/Settings/Settings.xml,src/UI/Windows/Windows.xml}]
charset = utf-8
end_of_line = lf
indent_style = tab
indent_size = 4
tab_width = 4
trim_trailing_whitespace = true
insert_final_newline = true

# Root YAML and package metadata
[/{.coderabbit.yaml,.pre-commit-config.yaml,_config.yml,.pkgmeta}]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
tab_width = 2
trim_trailing_whitespace = true
insert_final_newline = true

# Root JSON
[/.luarc.json]
charset = utf-8
end_of_line = lf
indent_style = tab
indent_size = 4
tab_width = 4
trim_trailing_whitespace = true
insert_final_newline = true

# Root shell scripts
[/Link ATT to WoW.sh]
charset = utf-8
end_of_line = lf
indent_style = tab
indent_size = 4
tab_width = 4
trim_trailing_whitespace = true
insert_final_newline = true

# Root Windows batch script
[/Link ATT to WoW.bat]
charset = utf-8
end_of_line = crlf
indent_style = tab
indent_size = 4
tab_width = 4
trim_trailing_whitespace = true
insert_final_newline = true

# Root WoW table of contents
[/AllTheThings.toc]
charset = utf-8
end_of_line = lf
indent_style = tab
indent_size = 4
tab_width = 4
trim_trailing_whitespace = true
insert_final_newline = true

# Root Markdown documentation
[/{AGENTS.md,README.md}]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
tab_width = 4
trim_trailing_whitespace = false
insert_final_newline = true

# Root license and configuration files
[/LICENSE]
charset = utf-8
end_of_line = lf
indent_style = tab
indent_size = 4
tab_width = 4
trim_trailing_whitespace = true
insert_final_newline = true

[/{.editorconfig,.gitattributes,.gitignore}]
charset = utf-8
end_of_line = lf
indent_style = tab
indent_size = 4
tab_width = 4
trim_trailing_whitespace = true
insert_final_newline = true

[/setup.cfg]
charset = utf-8
end_of_line = lf
indent_style = tab
indent_size = 4
tab_width = 4
trim_trailing_whitespace = true
insert_final_newline = true
